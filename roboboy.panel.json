{
  "schemaVersion": 1,
  "id": "co.sunriserobotics.roboboy.vr",
  "name": "VR Camera & Pose Teleop",
  "description": "View WHEP camera streams in a headset and publish clutched controller pose targets.",
  "version": "0.3.3",
  "entryPoint": "./dist/index.js",
  "integrity": "sha256-e1Zq3DhO5kecbVFE+VsBNt/RXV1e+E+3v0KT/LHtx7w=",
  "compatibility": {
    "panelApi": "^2.0.0",
    "roboboy": ">=0.8.0-alpha <1.0.0"
  },
  "capabilities": [
    "ros",
    "network",
    "storage",
    "webxr"
  ],
  "permissions": {
    "network": {
      "hostEndpoints": [
        "webrtcWhep",
        "webrtcDiscovery"
      ]
    },
    "ros": {
      "publish": [
        "/*/teleop_target_pose"
      ],
      "subscribe": [
        "/*/flange_pose"
      ]
    }
  },
  "author": {
    "name": "Sunrise Robotics"
  },
  "repository": "https://github.com/Sunrise-Robotics/robo-boy-vr-panel",
  "tags": [
    "vr",
    "webxr",
    "camera",
    "webrtc",
    "whep",
    "teleop"
  ]
}
