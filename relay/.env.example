# The cell to reach through the laptop's Sunrise VPN connection.
CELL_IP=10.243.10.22
CELL_HTTP_PORT=80
CELL_RTSP_PORT=8554

# The laptop address the Quest can reach on the home LAN.
VR_LAN_IP=192.168.1.34
VR_HTTPS_PORT=443
VR_ICE_PORT=8189

# Use absolute host paths. The existing whep-test mkcert files are valid for the example LAN IP.
VR_TLS_CERT=/absolute/path/to/cert.pem
VR_TLS_KEY=/absolute/path/to/key.pem
